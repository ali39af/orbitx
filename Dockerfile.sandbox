ARG UBUNTU_VERSION=24.04
ARG NODE_MAJOR=20

FROM ubuntu:${UBUNTU_VERSION} AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    wget \
    xz-utils \
    build-essential \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    pkg-config \
    sudo \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean

ARG NODE_MAJOR
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean

FROM base AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package.json ]; then \
    npm ci --no-audit --no-fund || npm install --no-audit --no-fund; \
    fi

COPY . .
RUN if [ -f package.json ]; then npm run build; fi

FROM base AS runtime

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libu2f-udev \
    libvulkan1 \
    libasound2t64 \
    xdg-utils \
    zip \
    unzip \
    p7zip-full \
    tar \
    gzip \
    git \
    bzip2 \
    xz-utils \
    && apt-get clean

# --- use the pre-existing UID/GID 1000 "ubuntu" user, give it sudo + workspace ---
RUN mkdir -p /home/ubuntu/workspace \
    && chown -R ubuntu:ubuntu /home/ubuntu \
    && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

RUN npx @puppeteer/browsers install chrome@151.0.7922.71 --path /opt/chrome \
    && chown -R ubuntu:ubuntu /opt/chrome

ENV CHROME_PATH=/opt/chrome/chrome/linux-151.0.7922.71/chrome-linux64/chrome \
    HEADLESS_BROWSER_SESSIONS=true

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --break-system-packages \
    requests \
    httpx \
    beautifulsoup4 \
    lxml \
    python-dateutil \
    pyyaml \
    python-dotenv \
    openpyxl \
    pillow \
    rich \
    numpy \
    pandas \
    matplotlib

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
RUN chown -R ubuntu:ubuntu /app

RUN mkdir -p /home/ubuntu/.npm-global /home/ubuntu/.cache \
    && chown -R ubuntu:ubuntu /home/ubuntu

ENV NPM_CONFIG_PREFIX=/home/ubuntu/.npm-global \
    PATH=/home/ubuntu/.npm-global/bin:$PATH \
    HOME=/home/ubuntu \
    WORKSPACE=/home/ubuntu/workspace

WORKDIR /home/ubuntu/workspace

USER ubuntu

RUN node --version && python3 --version && $CHROME_PATH --version

CMD ["node", "/app/dist/sandbox.js"]